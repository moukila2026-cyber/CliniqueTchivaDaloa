# Modèle uniquement. L'application ne charge PAS automatiquement ce fichier.
# Ne copiez jamais de secrets réels dans GitHub.
# Mode Neon/PostgreSQL :
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE_POOLE/BASE?sslmode=require&channel_binding=require
ENCRYPTION_KEY=CLE_FERNET_A_GENERER_SUR_VOTRE_APPAREIL
COOKIE_SECURE=1
PUBLIC_URL=https://VOTRE-DOMAINE-PUBLIC

# Maintenance uniquement (variables privées de votre poste) :
# DATABASE_URL_UNPOOLED=connexion_directe_privee_Neon
# BACKUP_KEY=cle_Fernet_distincte_conservee_hors_des_sauvegardes

# Mode SQLite LOCAL uniquement : ne pas définir DATABASE_URL ni VERCEL.
# DATA_DIR=/chemin/prive/persistant (facultatif hors Vercel)
# Les clés sont alors créées localement dans DATA_DIR, jamais à publier.
