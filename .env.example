# Variables à exporter dans le shell ou dans votre gestionnaire de services.
# L’application ne charge pas automatiquement ce fichier.
PUBLIC_URL=https://votre-domaine-a-configurer.ci
COOKIE_SECURE=1
TZ=Africa/Abidjan
DATA_DIR=/app/data
# ENCRYPTION_KEY= (facultatif : clé Fernet via gestionnaire de secrets ; sinon data/encryption.key)
# SETUP_KEY= (facultatif : code d’installation ; sinon data/setup.key)
# BACKUP_KEY= (clé Fernet distincte pour manage.py backup ; à garder hors serveur)
